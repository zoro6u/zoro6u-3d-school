# Backend (api/). Copy to .env — never commit the real file.
ANTHROPIC_API_KEY=
# Sonnet 5.5 is the default tutor model. claude-haiku-5-5 is the cheaper option for public demos.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Thinking depth: low | medium | high. "low" keeps 2–4 sentence spoken replies snappy.
ANTHROPIC_EFFORT=low
# Server-side refusal fallback (Claude API only). Try it after the basic setup works.
ANTHROPIC_FALLBACKS=false
MAX_OUTPUT_TOKENS=700

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Abuse limits
RATE_LIMIT_PER_MINUTE=20
TRUST_PROXY=false   # set true behind Render/Fly so the limiter sees real client IPs

# DEV/TEST ONLY: scripted fake LLM so the whole pipeline runs without a key. Leave false in production.
MOCK_LLM=false

# Frontend (web/.env): where the API lives when not using the Vite dev proxy
# VITE_API_BASE=https://your-api.example.com
