        },
        "pendulum_mass": {
          "type": "number",
          "ref": "physics.pendulum.mass",
          "description": "pendulum bob mass",
          "unit": "kg"
        },
        "pendulum_angle_deg": {
          "type": "number",
          "ref": "physics.pendulum.angleDeg",
          "description": "pendulum starting angle",
          "unit": "degrees"
