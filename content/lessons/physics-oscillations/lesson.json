          "type": "number",
          "ref": "physics.spring.k",
          "description": "spring constant",
          "unit": "N/m"
        },
        "spring_mass": {
          "type": "number",
          "ref": "physics.spring.mass",
          "description": "block mass",
          "unit": "kg"
        },
        "spring_displacement": {
          "type": "number",
          "ref": "physics.spring.displacement",
          "description": "starting stretch",
          "unit": "m"
